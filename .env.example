# ============================================
# WhatsApp Clone - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_clone
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_clone
DB_USER=user
DB_PASSWORD=password

# --- Redis (Session & Caching) ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# --- JWT Authentication ---
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# --- WebSocket (Socket.IO) ---
SOCKET_CORS_ORIGIN=http://localhost:5173

# --- File Upload (S3/MinIO) ---
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=whatsapp-clone-uploads
STORAGE_USE_SSL=false

# --- Email (SendGrid / SMTP) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@whatsapp-clone.local

# --- Push Notifications (Firebase) ---
FCM_SERVER_KEY=your-firebase-server-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# --- OAuth (Google, Facebook) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Frontend ---
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000
VITE_APP_NAME=WhatsApp Clone
VITE_APP_URL=http://localhost:5173
VITE_STORAGE_URL=http://localhost:9000