# ============================================
# WhatsApp Clone - Environment Variables
# ============================================
# Generated from .env.example with sensible defaults

# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_clone
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_clone
DB_USER=user
DB_PASSWORD=password

# --- Redis (Session & Caching) ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# --- JWT Authentication ---
JWT_SECRET=dev-jwt-secret-change-in-production-abc123
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-xyz789
JWT_REFRESH_EXPIRES_IN=30d

# --- WebSocket (Socket.IO) ---
SOCKET_CORS_ORIGIN=http://localhost:3000

# --- Email (SMTP) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# --- Storage (S3/Cloud) ---
S3_BUCKET=whatsapp-clone-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Push Notifications ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Feature Flags ---
ENABLE_VIDEO_CALLS=true
ENABLE_VOICE_CALLS=true
ENABLE_FILE_SHARING=true
ENABLE_READ_RECEIPTS=true

# --- API Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100